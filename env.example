PORT=5433
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gamefrog_db

PAYMENT_DATA_SECRET=change-me

ALLOWED_ORIGINS=https://gamefrog.ge

UNIPAY_MERCHANT_ID=YOUR_MERCHANT_ID
UNIPAY_SECRET_KEY=YOUR_SECRET_KEY
UNIPAY_MERCHANT_USER=merchant@example.com
UNIPAY_API_URL=https://apiv2.unipay.com/custom/checkout/v1
UNIPAY_SUCCESS_URL=http://localhost:5433/?payment=success
UNIPAY_CANCEL_URL=http://localhost:5433/?payment=cancel
UNIPAY_CALLBACK_URL=http://localhost:5433/api/payments/unipay/callback

# Google Analytics (replace with your actual ID from analytics.google.com)
# Example: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=GA_MEASUREMENT_ID

# AI Chat Settings
# You can set API keys here or configure them in Admin Settings → AI Chat Settings
# Get your API keys from:
# - Gemini: https://makersuite.google.com/app/apikey
# - OpenAI: https://platform.openai.com/api-keys
# - DeepSeek: https://platform.deepseek.com/api_keys
# - Anthropic: https://console.anthropic.com/

# Gemini API Key (Google AI)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (ChatGPT)
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Anthropic API Key (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
