{
  "name": "ai-chat-service",
  "version": "1.0.0",
  "description": "Separate module for AI Chat and Comments functionality",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npx nodemon --exec tsx server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2",
    "mysql2": "^3.11.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "typescript": "~5.8.2",
    "tsx": "^4.19.1",
    "nodemon": "^3.1.9"
  }
