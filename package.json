{
  "name": "gamefrog-ge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx nodemon --exec tsx server/server.ts",
    "dev:frontend": "vite",
    "dev:backend": "npx nodemon --exec tsx server/server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "server:dev": "npx nodemon --exec tsx server/server.ts",
    "server:build": "tsc -p server/tsconfig.json",
    "server:start": "node dist/server.js",
    "server:type-check": "tsc -p server/tsconfig.json --noEmit",
    "server:create-admin": "tsx server/scripts/createAdmin.ts",
    "server:free-port": "tsx server/scripts/freePort.ts",
    "server:migrate-payment-settings": "tsx server/scripts/runPaymentSettingsMigration.ts",
    "server:migrate-user-settings": "tsx server/scripts/runUserSettingsMigration.ts",
    "server:migrate-user-messages": "tsx server/scripts/runUserMessagesMigration.ts",
    "server:migrate-user-contact": "tsx server/scripts/runUserContactMigration.ts",
    "server:migrate-fix-image-urls": "tsx server/scripts/runFixImageUrlsMigration.ts",
    "server:migrate-youtube-video-id": "tsx server/scripts/runYoutubeVideoIdMigration.ts",
    "server:migrate-limited-time-offers": "tsx server/scripts/runLimitedTimeOffersMigration.ts",
    "server:migrate-add-product-id-to-offers": "tsx server/scripts/runAddProductIdToOffersMigration.ts",
    "server:migrate-offer-products": "tsx server/scripts/runOfferProductsMigration.ts",
    "server:migrate-show-frequency": "tsx server/scripts/runShowFrequencyMigration.ts",
    "server:migrate-text-colors": "tsx server/scripts/runTextColorsMigration.ts",
    "server:migrate-button-timer-templates": "tsx server/scripts/runButtonTimerTemplatesMigration.ts",
    "server:migrate-remove-unused-offer-fields": "tsx server/scripts/runRemoveUnusedFieldsMigration.ts",
    "server:migrate-background-color": "tsx server/scripts/runBackgroundColorMigration.ts",
    "server:migrate-filter-groups": "tsx server/scripts/runFilterGroupsMigration.ts",
    "server:migrate-filter-assignments": "tsx server/scripts/runFilterAssignmentsMigration.ts",
    "server:migrate-filter-display-order": "tsx server/scripts/runDisplayOrderMigration.ts",
    "generate-icons": "node scripts/generate-icons.mjs",
    "test": "tsx --test server/tests/**/*.test.ts",
    "test:watch": "tsx --test --watch server/tests/**/*.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
