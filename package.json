{
  "name": "gamefrog-ge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx nodemon --exec tsx server/server.ts",
    "dev:frontend": "vite",
    "dev:backend": "npx nodemon --exec tsx server/server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "server:dev": "npx nodemon --exec tsx server/server.ts",
    "server:build": "tsc -p server/tsconfig.json",
    "server:start": "node dist/server.js",
    "server:type-check": "tsc -p server/tsconfig.json --noEmit",
    "server:create-admin": "tsx server/scripts/createAdmin.ts",
    "server:free-port": "tsx server/scripts/freePort.ts",
    "generate-icons": "node scripts/generate-icons.mjs",
    "test": "tsx --test server/tests/**/*.test.ts",
    "test:watch": "tsx --test --watch server/tests/**/*.test.ts",
    "ai-chat:dev": "cd modules/ai-chat-service && npm run dev",
    "ai-chat:build": "cd modules/ai-chat-service && npm run build",
    "ai-chat:start": "cd modules/ai-chat-service && npm start"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@tailwindcss/vite": "^4.1.17",
    "@types/multer": "^2.0.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "i18next": "^25.6.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.553.0",
    "multer": "^2.0.2",
    "mysql2": "^3.11.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.3.3",
    "tailwindcss": "^4.1.17",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "expect": "^30.2.0",
    "nodemon": "^3.1.9",
    "sharp": "^0.34.5",
    "tsx": "^4.19.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
